{
  "name": "wirewhy",
  "version": "0.2.0",
  "description": "Check websites, inspect NGINX health, and explain failures with server logs and runtime evidence.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Aaron-Savron/wirewhy.git" },
  "homepage": "https://github.com/Aaron-Savron/wirewhy#readme",
  "bugs": { "url": "https://github.com/Aaron-Savron/wirewhy/issues" },
  "engines": { "node": ">=20.3.0" },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.mjs", "require": "./src/index.js" },
    "./register": { "types": "./src/register.d.ts", "default": "./src/register.js" },
    "./package.json": "./package.json"
  },
  "bin": { "wirewhy": "./src/cli.js" },
  "files": ["src/*.js", "src/*.mjs", "src/*.d.ts", "src/*.py", "docs", "assets", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/cli.test.js test/diagnose.test.js test/observe.test.js test/report.test.js test/site.test.js test/logs.test.js",
    "test:types": "tsc --noEmit --strict --noUncheckedSideEffectImports --module nodenext --moduleResolution nodenext --target es2022 test/types.mts test/types.cts",
    "test:package": "node scripts/pack-smoke.mjs",
    "check": "npm run test:types && npm test",
    "prepublishOnly": "npm run check",
    "demo": "node examples/demo.js"
  },
  "keywords": ["nginx", "website", "logs", "fetch", "debugging", "diagnostics", "undici", "network", "cli", "tls", "dns"],
  "devDependencies": { "typescript": "^5.9.3" }
}
